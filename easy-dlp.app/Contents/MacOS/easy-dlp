#!/bin/bash
# Use Terminal's Desktop/Documents access and share the Finder launcher lifecycle.
set -euo pipefail
PROJECT_ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
exec osascript - "$PROJECT_ROOT/Open easy-dlp.command" <<'APPLESCRIPT'
on run argv
    tell application "Terminal"
        activate
        do script "exec /bin/bash " & quoted form of (item 1 of argv)
    end tell
end run
APPLESCRIPT
